<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit your message</title>
     <link rel="stylesheet" href="/style.css">
    
</head>
<body class="home">
    <h2>Add a new chat...</h2>
    <form method="POST" action="/chats">
        <input placeholder="your name?" name="from">
        <br> <br>
        <textarea placeholder="Add your message here!" name="msg"></textarea>
        <br> <br>
        <input placeholder="sends to?" name="to">
        <br> <br>
        <button>Create Chat</button>
    </form>
</body>
</html>
